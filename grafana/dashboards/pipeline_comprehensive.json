{
  "uid": "pipeline-comprehensive",
  "title": "Pipeline Comprehensive Monitoring",
  "tags": [
    "pipeline",
    "monitoring",
    "parsing",
    "vision",
    "tagging",
    "enrichment",
    "indexing",
    "context7"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "id": null,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Pipeline Overview - Posts Flow",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(posts_parsed_total[5m]))",
          "refId": "A",
          "legendFormat": "Parsed",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(vision_analysis_requests_total{status=\"ok\"}[5m]))",
          "refId": "B",
          "legendFormat": "Vision Analyzed",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(tagging_processed_total{status=\"success\"}[5m]))",
          "refId": "C",
          "legendFormat": "Tagged",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(enrichment_requests_total{success=\"true\"}[5m]))",
          "refId": "D",
          "legendFormat": "Enriched",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(indexing_processed_total{status=\"success\"}[5m]))",
          "refId": "E",
          "legendFormat": "Indexed",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "Scheduler Status",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "scheduler_running",
          "refId": "A",
          "legendFormat": "Running",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "Stopped",
                  "color": "red"
                },
                "1": {
                  "text": "Running",
                  "color": "green"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Scheduler Jobs",
